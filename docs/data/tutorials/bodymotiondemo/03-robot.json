:"doc:\/\/com.example.BodyMotionDemo\/tutorials\/BodyMotionDemo\/03-Robot"},"kind":"project","sections":[{"image":"chapter-robot.png","backgroundImage":"chapter-robot.png","chapter":"로봇 등장","estimatedTimeInMinutes":25,"kind":"hero","title":"로봇 등장","content":[{"inlineContent":[{"type":"text","text":"파이프라인의 마지막 조각입니다 — robot.usdz를 로딩해서 사람 위치의 깃발에"},{"type":"text","text":" "},{"type":"text","text":"매달면("},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"type":"text","text":"), 로봇이 사람의 움직임을 따라 합니다. 91개 관절을 하나하나"},{"type":"text","text":" "},{"type":"text","text":"움직이는 코드는 쓰지 않습니다. "},{"type":"codeVoice","code":"BodyTrackedEntity"},{"type":"text","text":"를 깃발에 매달아 두기만 하면"},{"type":"text","text":" "},{"type":"text","text":"RealityKit이 관절 애니메이션을 알아서 구동합니다."}],"type":"paragraph"}]},{"kind":"tasks","tasks":[{"stepsSection":[{"caption":[],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"code":"BodyTrackingState","type":"codeVoice"},{"text":"에 로딩 실패 메시지 프로퍼티를 한 줄 추가합니다.","type":"text"}]}],"media":null,"code":"03-robot-01-BodyTrackingState.swift"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"방향이 아니라 “거리만” 정해 두는 이유: 로봇을 세울 “옆” 방향은","type":"text"},{"text":" ","type":"text"},{"text":"카메라가 어디 있느냐에 따라 달라지므로, 잠시 뒤 매 프레임","type":"text"},{"text":" ","type":"text"},{"text":"카메라 기준으로 다시 계산합니다.","type":"text"}]}],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"Coordinator에 세 가지 도구를 추가합니다 — 로봇을 매달아 둘 빈 앵커","type":"text"},{"text":" ","type":"text"},{"code":"characterAnchor","type":"codeVoice"},{"text":", 로딩이 끝난 모델을 보관할 ","type":"text"},{"code":"character","type":"codeVoice"},{"text":", 그리고","type":"text"},{"text":" ","type":"text"},{"text":"로봇을 사람 옆에 세울 거리 ","type":"text"},{"code":"characterOffsetDistance","type":"codeVoice"},{"text":".","type":"text"}]}],"media":null,"code":"03-robot-02-ARViewContainer.swift"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"옛날 튜토리얼의 ","type":"text"},{"code":"loadBodyTrackedAsync","type":"codeVoice"},{"text":" + Combine 코드는 iOS 18부터","type":"text"},{"text":" ","type":"text"},{"text":"deprecated입니다. 지금은 이 ","type":"text"},{"code":"try await","type":"codeVoice"},{"text":" 한 줄이 공식 경로입니다.","type":"text"}]}],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"code":"loadCharacter()","type":"codeVoice"},{"text":"를 추가합니다. ","type":"text"},{"code":"try await BodyTrackedEntity(named: \"robot\")","type":"codeVoice"},{"text":"이","type":"text"},{"text":" ","type":"text"},{"text":"번들에서 robot.usdz를 로딩합니다(확장자 생략). 실패하면 에러 메시지를","type":"text"},{"text":" ","type":"text"},{"text":"상태에 담아 화면으로 보냅니다.","type":"text"}]}],"media":null,"code":"03-robot-03-ARViewContainer.swift"},{"caption":[],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"code":"makeUIView","type":"codeVoice"},{"text":"에서 빈 앵커를 씬에 미리 꽂고, 로딩을 시작합니다.","type":"text"}]}],"media":null,"code":"03-robot-04-ARViewContainer.swift"}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"로봇 모델은 약 14MB라 로딩에 수 초가 걸립니다. ","type":"text"},{"code":"try await","type":"codeVoice"},{"text":"로 비동기","type":"text"},{"text":" ","type":"text"},{"text":"로딩하고, 실패하면 화면에 빨간 에러 배너를 띄웁니다 — “비동기 작업은","type":"text"},{"text":" ","type":"text"},{"text":"실패할 수 있고, 실패는 화면에 보여야 한다”는 좋은 연습입니다.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"로봇-비동기-로딩","title":"로봇 비동기 로딩"},{"stepsSection":[{"caption":[],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"code":"session(_:didUpdate:)","type":"codeVoice"},{"text":"와 옆 방향을 구하는 ","type":"text"},{"code":"sideOffset","type":"codeVoice"},{"text":"을 추가합니다.","type":"text"},{"text":" ","type":"text"},{"text":"핵심은 세 가지입니다 —","type":"text"},{"text":" ","type":"text"},{"text":"① 앵커의 위치(사람 ","type":"text"},{"inlineContent":[{"type":"text","text":"골반"}],"type":"strong"},{"text":"의 월드 좌표)에 옆 오프셋을 더해 깃발을","type":"text"},{"text":" ","type":"text"},{"text":"옮기고(방향은 하늘 축과 “카메라→사람” 벡터의 ","type":"text"},{"inlineContent":[{"type":"text","text":"외적"}],"type":"strong"},{"text":"으로 매 프레임","type":"text"},{"text":" ","type":"text"},{"text":"계산합니다 — 방향을 월드 좌표에 고정하면 시점에 따라 로봇이 카메라","type":"text"},{"text":" ","type":"text"},{"text":"앞을 가로막아 화면을 꽉 채우는 함정이 있습니다),","type":"text"},{"text":" ","type":"text"},{"text":"② 앵커의 ","type":"text"},{"inlineContent":[{"type":"text","text":"회전도 복사"}],"type":"strong"},{"text":"하며(스켈레톤 포즈가 앵커 회전 기준 상대값이라,","type":"text"},{"text":" ","type":"text"},{"text":"빼먹으면 사람이 몸을 돌려도 로봇은 같은 방향만 봅니다),","type":"text"},{"text":" ","type":"text"},{"text":"③ “로딩 완료 + 사람 감지”가 처음 동시에 충족된 프레임에 딱 한 번","type":"text"},{"text":" ","type":"text"},{"text":"로봇을 매답니다(lazy attach — 로딩과 발견 중 어느 쪽이 먼저일지 모르므로).","type":"text"}]}],"media":null,"code":"03-robot-05-ARViewContainer.swift"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"한 가지 함정: ","type":"text"},{"code":"BodyMotionDemoApp.swift","type":"codeVoice"},{"text":"에는 절대 ","type":"text"},{"code":"import RealityKit","type":"codeVoice"},{"text":"을","type":"text"},{"text":" ","type":"text"},{"text":"추가하지 마세요. SwiftUI의 ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":"과 RealityKit의 ","type":"text"},{"code":"Scene","type":"codeVoice"},{"text":" 이름이 충돌해","type":"text"},{"text":" ","type":"text"},{"text":"“‘Scene’ is ambiguous” 에러가 납니다.","type":"text"}]}],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"code":"ContentView","type":"codeVoice"},{"text":"에 로딩 실패 배너를 추가하면 완성입니다.","type":"text"}]}],"media":null,"code":"03-robot-06-ContentView.swift"},{"caption":[{"type":"paragraph","inlineContent":[{"text":"빨간 배너(“로봇 모델을 불러오지 못했어요”)가 뜨면 robot.usdz의","type":"text"},{"text":" ","type":"text"},{"text":"Target Membership을 확인하세요. ","type":"text"},{"code":"characterOffsetDistance","type":"codeVoice"},{"text":"를 ","type":"text"},{"code":"0","type":"codeVoice"},{"text":"으로","type":"text"},{"text":" ","type":"text"},{"text":"바꾸면 로봇이 사람 위치에 겹쳐져 “사람이 로봇이 된” 화면이 됩니다.","type":"text"}]}],"runtimePreview":null,"type":"step","content":[{"type":"paragraph","inlineContent":[{"text":"실행하고 사람 전신을 비춥니다. ","type":"text"},{"inlineContent":[{"type":"text","text":"사람 왼쪽 1m에 로봇이 서서 걷기,"},{"type":"text","text":" "},{"type":"text","text":"팔 들기, 춤을 전부 따라 하면 완성입니다."}],"type":"strong"},{"text":" ✅ 🎉","type":"text"}]}],"media":null,"code":null}],"contentSection":[{"kind":"contentAndMedia","content":[{"type":"paragraph","inlineContent":[{"text":"이제 매 프레임 호출되는 ","type":"text"},{"code":"session(_:didUpdate:)","type":"codeVoice"},{"text":"에서 깃발을 사람 위치로","type":"text"},{"text":" ","type":"text"},{"text":"옮기고, 준비가 끝난 첫 프레임에 로봇을 깃발에 매답니다.","type":"text"}]}],"mediaPosition":"trailing"}],"anchor":"사람-따라-움직이기","title":"사람 따라 움직이기"}]},{"assessments":[{"choices":[{"content":[{"type":"paragraph","inlineContent":[{"text":"발바닥 (바닥에 닿는 지점)","type":"text"}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"text":"발바닥이 아니라서, 로봇을 ‘바닥에’ 세우려면 골반→발 오프셋을","type":"text"},{"text":" ","type":"text"},{"text":"따로 계산해야 합니다.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"골반 (hip joint)","type":"text"}]}],"isCorrect":true,"justification":[{"type":"paragraph","inlineContent":[{"text":"바디 앵커의 transform은 hip joint의 월드 좌표입니다.","type":"text"},{"text":" ","type":"text"},{"text":"나머지 91개 관절은 이 앵커 기준의 상대 좌표로 제공됩니다.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"머리 (head joint)","type":"text"}]}],"isCorrect":false,"justification":[{"type":"paragraph","inlineContent":[{"text":"루트는 머리가 아니라 골반입니다. 스켈레톤 계층의 루트 관절이","type":"text"},{"text":" ","type":"text"},{"text":"hip이고, 앵커의 위치가 바로 그 지점입니다.","type":"text"}]}]}],"type":"multiple-choice","content":[],"title":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ARBodyAnchor.transform"},{"text":"의 위치는 사람 몸의 어디일까요?","type":"text"}]}]},{"choices":[{"content":[{