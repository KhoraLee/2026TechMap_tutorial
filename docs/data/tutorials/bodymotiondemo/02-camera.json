-%EC%9B%80%EC%A7%81%EC%9D%B4%EA%B8%B0","title":"사람 따라 움직이기","role":"pseudoSymbol","url":"\/tutorials\/bodymotiondemo\/03-robot#%EC%82%AC%EB%9E%8C-%EB%94%B0%EB%9D%BC-%EC%9B%80%EC%A7%81%EC%9D%B4%EA%B8%B0","kind":"section","abstract":[{"text":"파이프라인의 마지막 조각입니다 — robot.usdz를 로딩해서 사람 위치의 깃발에","type":"text"},{"text":" ","type":"text"},{"text":"매달면(","type":"text"},{"type":"strong","inlineContent":[{"text":"entity","type":"text"}]},{"text":"), 로봇이 사람의 움직임을 따라 합니다. 91개 관절을 하나하나","type":"text"},{"text":" ","type":"text"},{"text":"움직이는 코드는 쓰지 않습니다. ","type":"text"},{"code":"BodyTrackedEntity","type":"codeVoice"},{"text":"를 깃발에 매달아 두기만 하면","type":"text"},{"text":" ","type":"text"},{"text":"RealityKit이 관절 애니메이션을 알아서 구동합니다.","type":"text"}]},"02-person-04-ARViewContainer.swift":{"content":["import SwiftUI","import RealityKit","import ARKit","","\/\/\/ SwiftUI 세계에 UIKit 뷰(ARView)를 올려 주는 어댑터.","struct ARViewContainer: UIViewRepresentable {","    let state: BodyTrackingState","","    func makeUIView(context: Context) -> ARView {","        let arView = ARView(frame: .zero)","","        \/\/ 사람(몸)을 추적하는 모드로 카메라 세션을 시작합니다.","        arView.session.delegate = context.coordinator","        let configuration = ARBodyTrackingConfiguration()","        arView.session.run(configuration)","","        return arView","    }","","    func updateUIView(_ uiView: ARView, context: Context) {}","","    func makeCoordinator() -> Coordinator {","        Coordinator(state: state)","    }","}","","extension ARViewContainer {","    \/\/\/ ARSession이 보내는 소식(앵커 추가·갱신)을 받는 우체통.","    final class Coordinator: NSObject, ARSessionDelegate {","        let state: BodyTrackingState","","        init(state: BodyTrackingState) {","            self.state = state","        }","","        \/\/\/ 새 앵커가 '처음' 생길 때 한 번만 호출됩니다 — 사람을 처음 발견한 순간.","        func session(_ session: ARSession, didAdd anchors: [ARAnchor]) {","            guard anchors.contains(where: { $0 is ARBodyAnchor }) else { return }","            print(\"사람 감지됨!\")","            state.isPersonDetected = true","        }","    }","}"],"identifier":"02-person-04-ARViewContainer.swift","highlights":[{"line":10},{"line":11},{"line":12},{"line":13},{"line":14},{"line":15},{"line":16},{"line":17}],"type":"file","syntax":"swift","fileName":"ARViewContainer.swift","fileType":"swift"},"02-person-05-ContentView.swift":{"content":["import SwiftUI","import ARKit","","struct ContentView: View {","    \/\/\/ AR 세계(Coordinator)와 SwiftUI 화면을 잇는 공유 상태","    @State private var trackingState = BodyTrackingState()","","    var body: some View {","        \/\/ 바디 트래킹은 A12 칩 이상 실기기에서만 지원됩니다.","        if ARBodyTrackingConfiguration.isSupported {","            ZStack(alignment: .top) {","                ARViewContainer(state: trackingState)","                    .ignoresSafeArea()","","                detectionBadge","                    .padding(.top, 8)","            }","        } else {","            unsupportedView","        }","    }","","    \/\/\/ 사람 감지 상태를 보여주는 상단 배지","    private var detectionBadge: some View {","        Text(trackingState.isPersonDetected ? \"🟢 사람 감지됨\" : \"⚪️ 사람을 찾는 중…\")","            .font(.headline)","            .padding(.horizontal, 16)","            .padding(.vertical, 8)","            .background(.thinMaterial, in: Capsule())","    }","","    \/\/\/ 미지원 기기(및 시뮬레이터)에서 보여주는 안내 화면","    private var unsupportedView: some View {","        ContentUnavailableView(","            \"이 기기는 모션 캡처를 지원하지 않아요\",","            systemImage: \"figure.walk.motion\",","            description: Text(\"바디 트래킹은 A12 칩 이상을 탑재한 실제 iPhone\/iPad에서만 동작합니다. 시뮬레이터에서는 항상 이 화면이 보입니다.\")","        )","    }","}","","#Preview {","    ContentView()","}"],"identifier":"02-person-05-ContentView.swift","highlights":[],"type":"file","syntax":"swift","fileName":"ContentView.swift","fileType":"swift"},"doc://com.example.BodyMotionDemo/tutorials/MotionCapture/----------":{"identifier":"doc:\/\/com.example.BodyMotionDemo\/tutorials\/MotionCapture\/----------","role":"article","abstract":[],"kind":"article","type":"topic","url":"\/tutorials\/motioncapture\/----------","title":"카메라와 사람 찾기"},"02-person-02-ARViewContainer.swift":{"content":["import SwiftUI","import RealityKit","import ARKit","","\/\/\/ SwiftUI 세계에 UIKit 뷰(ARView)를 올려 주는 어댑터.","struct ARViewContainer: UIViewRepresentable {","    let state: BodyTrackingState","","    func makeUIView(context: Context) -> ARView {","        ARView(frame: .zero)","    }","","    func updateUIView(_ uiView: ARView, context: Context) {}","","    func makeCoordinator() -> Coordinator {","        Coordinator(state: state)","    }","}","","extension ARViewContainer {","    \/\/\/ ARSession이 보내는 소식(앵커 추가·갱신)을 받는 우체통.","    final class Coordinator: NSObject, ARSessionDelegate {","        let state: BodyTrackingState","","        init(state: BodyTrackingState) {","            self.state = state","        }","    }","}"],"identifier":"02-person-02-ARViewContainer.swift","highlights":[],"type":"file","syntax":"swift","fileName":"ARViewContainer.swift","fileType":"swift"},"02-person-03-ARViewContainer.swift":{"content":["import SwiftUI","import RealityKit","import ARKit","","\/\/\/ SwiftUI 세계에 UIKit 뷰(ARView)를 올려 주는 어댑터.","struct ARViewContainer: UIViewRepresentable {","    let state: BodyTrackingState","","    func makeUIView(context: Context) -> ARView {","        ARView(frame: .zero)","    }","","    func updateUIView(_ uiView: ARView, context: Context) {}","","    func makeCoordinator() -> Coordinator {","        Coordinator(state: state)","    }","}","","extension ARViewContainer {","    \/\/\/ ARSession이 보내는 소식(앵커 추가·갱신)을 받는 우체통.","    final class Coordinator: NSObject, ARSessionDelegate {","        let state: BodyTrackingState","","        init(state: BodyTrackingState) {","            self.state = state","        }","","        \/\/\/ 새 앵커가 '처음' 생길 때 한 번만 호출됩니다 — 사람을 처음 발견한 순간.","        func session(_ session: ARSession, didAdd anchors: [ARAnchor]) {","            guard anchors.contains(where: { $0 is ARBodyAnchor }) else { return }","            print(\"사람 감지됨!\")","            state.isPersonDetected = true","        }","    }","}"],"identifier":"02-person-03-ARViewContainer.swift","highlights":[{"line":28},{"line":29},{"line":30},{"line":31},{"line":32},{"line":33},{"line":34}],"type":"file","syntax":"swift","fileName":"ARViewContainer.swift","fileType":"swift"},"chapter-camera.png":{"type":"image","alt":"카메라 챕터 아트워크","variants":[{"url":"\/images\/com.example.BodyMotionDemo\/chapter-camera.png","traits":["1x","light"]}],"identifier":"chapter-camera.png"},"doc://com.example.BodyMotionDemo/tutorials/MotionCapture":{"identifier":"doc:\/\/com.example.BodyMotionDemo\/tutorials\/MotionCapture","role":"overview","abstract":[{"text":"ARKit의 바디 트래킹으로, 카메라에 잡힌 사람 옆에 로봇이 나타나 그 사람의","type":"text"},{"text":" ","type":"text"},{"text":"동작을 실시간으로 따라 하는 앱을 만듭니다.","type":"text"}],"kind":"overview","type":"topic","url":"\/tutorials\/motioncapture","title":"내 몸을 따라 움직이는 3D 캐릭터"},"doc://com.example.BodyMotionDemo/tutorials/BodyMotionDemo/03-Robot#Check-Your-Understanding":{"type":"link","titleInlineContent":[{"text":"Check Your Understanding","type":"text"}],"title":"Check Your Understanding","url":"\/tutorials\/bodymotiondemo\/03-robot#Check-Your-Understanding","identifier":"doc:\/\/com.example.BodyMotionDemo\/tutorials\/BodyMotionDemo\/03-Robot#Check-Your-Understanding"},"02-person-01-BodyTrackingState.swift":{"content":["import Observation","","\/\/\/ AR 세션에서 일어나는 일을 SwiftUI 화면에 전달하는 상태 저장소.","@Observable","final class BodyTrackingState {","    \/\/\/ 지금 카메라에 사람이 잡혀 있는지","    var isPersonDetected = false","}"],"identifier":"02-person-01-BodyTrackingState.swift","highlights":[],"type":"file","syntax":"swift","fileName":"BodyTrackingState.swift","fileType":"swift"}}}